{
  "manifest_version": 3,
  "name": "ZCode Browser Use",
  "description": "Lets the ZCode GPUI app's agent use this browser: open tabs in a ZCode group, read pages, click and type.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["nativeMessaging", "debugger", "tabs", "tabGroups", "storage", "alarms"]
}
