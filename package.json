{
  "name": "zcode",
  "version": "3.16.2",
  "private": true,
  "type": "module",
  "scripts": {
    "gpui": "cargo build --bins --manifest-path apps/zcode-gpui/Cargo.toml && cargo run --manifest-path apps/zcode-gpui/Cargo.toml -- --workspace .",
    "dev:gpui": "cargo build --bins --manifest-path apps/zcode-gpui/Cargo.toml && cargo run --manifest-path apps/zcode-gpui/Cargo.toml -- --workspace .",
    "start:gpui": "cargo build --release --bins --manifest-path apps/zcode-gpui/Cargo.toml && bun apps/zcode-gpui/scripts/build_backend.ts --outdir apps/zcode-gpui/target/release && cargo run --release --manifest-path apps/zcode-gpui/Cargo.toml -- --workspace .",
    "package:gpui": "node scripts/package-gpui.mjs",
    "prepare": "husky && bun run build:cua",
    "build:cua": "bun run --filter @zcode/zcode-cua build",
    "typecheck": "tsc -b packages/shared/tsconfig.testing.json packages/shared packages/browser-commands apps/zcode-browser-extension",
    "typecheck:fast": "bun apps/zcode-gpui/scripts/typecheck_fast.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "verify:pre-push": "cargo fmt --check --manifest-path apps/zcode-gpui/Cargo.toml && cargo clippy --manifest-path apps/zcode-gpui/Cargo.toml --all-targets -- -D warnings",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context",
    "dep:refs": "node scripts/dep-refs.mjs"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.1",
    "@zcode/zcode-cua": "workspace:*",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "bun@1.4.3",
  "overrides": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vitest": "4.1.7",
    "@vitest/coverage-v8": "4.1.7"
  },
  "patchedDependencies": {
    "@radix-ui/react-collapsible@1.1.12": "patches/@radix-ui__react-collapsible@1.1.12.patch",
    "vitest@4.1.7": "patches/vitest@4.1.7.patch",
    "wdio-electron-service@9.2.1": "patches/wdio-electron-service@9.2.1.patch",
    "@arms/rum-electron@0.0.3": "patches/@arms__rum-electron@0.0.3.patch",
    "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
    "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
  },
  "workspaces": [
    "apps/dev-docs",
    "packages/*",
    "apps/zcode-cli",
    "apps/zcode-cli/packages/*",
    "apps/zcode-cli/tools/*"
  ],
  "license": "Apache-2.0"
}
